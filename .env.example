# Public web/mobile Supabase client values. These are safe to expose when RLS is correct.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase values. Never expose these to browser or mobile clients.
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# Staff/admin auth.
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Provider API keys. Add concrete provider names as they are evaluated.
SPORTS_PROVIDER_PRIMARY_API_KEY=
ODDS_PROVIDER_PRIMARY_API_KEY=

# App/runtime defaults.
DEFAULT_LOCALE=bg
SUPPORTED_LOCALES=bg,en
DEFAULT_TIMEZONE=Europe/Sofia
